#include <stdio.h> 
int main() { 
    int status, totalCheckIn = 0; 
    for(int i = 1; i <= 25; i++) { 
        printf("Member %d (1 = Checked In, 0 = Absent): ", i); 
        scanf("%d", &status); 
        if(status==1) { 
            totalCheckIn++; 
        } 
    } 
    printf("Total Members Checked In: %d\n", totalCheckIn); 
    return 0; 
} 
