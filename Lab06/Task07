#include <stdio.h> 
int main() { 
    int choice; 
    do { 
         printf("======MENU========\n"); 
        printf("1. Issue Book\n"); 
        printf("2. Return Book\n"); 
        printf("3. Exit\n"); 
        printf("Enter choice: "); 
        scanf("%d", &choice); 
        switch(choice) { 
            case 1: 
                printf("Book Issued Successfully.\n"); 
                break; 
            case 2: 
                printf("Book Returned Successfully.\n"); 
                break; 
            case 3: 
                printf("System Exited Successfully.\n"); 
                break; 
            default: 
                printf("Invalid Choice.\n"); 
        } 
    } while(choice != 3); 
    return 0; 
} 
