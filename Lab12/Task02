#include <stdio.h>  
#include <stdlib.h>  
int main()  
{ int *contacts = (int *)malloc(3 * sizeof(int)); 
 printf("Enter 3 contact IDs:\n"); 
 for (int i = 0; i < 3; i++) 
 scanf("%d", &contacts[i]); 
 int *temp = (int *)realloc(contacts, 5 * sizeof(int)); 
 if (temp == NULL) {  
printf("Expansion failed!\n"); 
 free(contacts); 
 return 1; } 
 contacts = temp; 
 printf("Enter 2 more contact IDs:\n"); 
 for (int i = 3; i < 5; i++) 
 scanf("%d", &contacts[i]); 
 printf("\nFull Contact List: "); 
 for (int i = 0; i < 5; i++)  
printf("%d ", contacts[i]); free(contacts); 
 contacts = NULL;  
return 0; } 
