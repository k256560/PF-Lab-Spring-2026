#include <stdio.h> 
#include <string.h> 
int main() { 
    char email[50], copy[50], display[100] = "Email: "; 
    printf("Enter email: "); 
    scanf("%s", email);
    strcpy(copy, email); 
    char *at_ptr = strchr(copy, '@'); 
    if (at_ptr != NULL && strstr(at_ptr, ".") != NULL) { 
        printf("Domain: %s\n", at_ptr + 1); 
        strcat(display, email); 
        printf("%s\n", display); 
    } else { 
        printf("Error: Invalid email format.\n"); 
    } 
    return 0; 
} 
