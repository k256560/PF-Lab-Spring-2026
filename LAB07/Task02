#include <stdio.h>
int main() {
    int a[10];
    int search, count = 0, i;
    printf("Enter 10 numbers: ");
    for(i = 0; i < 10; i++) {
    scanf("%d", &a[i]);
}
    printf("Enter number to search: ");
    scanf("%d", &search);
    for(i = 0; i < 10; i++) {
        if(a[i] == search) {
        count++;}
    }
    if(count > 0) 
    {
        printf("%d occurred %d times.\n", search, count);
    }
    else {
    printf("Number not found.\n");}
    return 0;
}
