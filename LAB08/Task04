#include <stdio.h> 
 int main() { 
 int mat[3][3], trans[3][3], cofac[3][3], adj[3][3];  
float inv[3][3],det = 0; 
 printf("Enter the 9 elements:\n"); 
 for(int i = 0; i < 3; i++) { 
 for(int j = 0; j < 3; j++) {  
scanf("%d", &mat[i][j]); } }  
for(int i = 0; i < 3; i++) {  
for(int j = 0; j < 3; j++) {  
trans[j][i] = mat[i][j]; } } 
 for(int i = 0; i < 3; i++) {  
det += (mat[0][i] * (mat[1][(i+1)%3] * mat[2][(i+2)%3] - mat[1][(i+2)%3] * mat[2][(i+1)%3])); } for(int i = 0; i < 3; i++) {  
for(int j = 0; j < 3; j++) { 
float minorDet = (mat[(i+1)%3][(j+1)%3] * mat[(i+2)%3][(j+2)%3]) -  
       (mat[(i+1)%3][(j+2)%3] * mat[(i+2)%3][(j+1)%3]); 
        
       cofac[i][j] = minorDet;  
       adj[j][i] = minorDet;  
   } 
} 
printf("Transpose Matrix:\n"); 
for(int i=0; i<3; i++) { 
   for(int j=0; j<3; j++) printf("%d ", trans[i][j]); 
   printf("\n"); 
} 
printf("Determinant: %d ", det); 
printf(" Cofactor Matrix:\n"); 
for(int i=0; i<3; i++) { 
   for(int j=0; j<3; j++) printf("%d ", cofac[i][j]); 
   printf("\n"); 
} 
printf("Adjoint Matrix:\n"); 
for(int i=0; i<3; i++) { 
   for(int j=0; j<3; j++) printf("%d ", adj[i][j]); 
   printf("\n"); 
} 
if(det == 0) { 
   printf("Inverse: Not possible (Singular Matrix)\n"); 
} else { 
   printf(" Inverse Matrix (Adjoint / Det):\n"); 
   for(int i=0; i<3; i++) { 
       for(int j=0; j<3; j++) { 
           inv[i][j] = adj[i][j] / det; 
           printf("%.2f ", inv[i][j]); 
       } 
       printf("\n"); 
   } 
} 
return 0; 

} 
