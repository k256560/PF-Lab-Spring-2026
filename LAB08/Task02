#include <stdio.h> 
int main() { 
    int seats[5][6] = {0}, available = 0, maxRow = 0, Booked =1; 
    for(int i = 0; i < 5; i++)  
    {
        int rowBooked = 0; 
        for(int j = 0; j < 6; j++) { 
            if(seats[i][j] == 0) { 
                available++;} 
            else  
            rowBooked++; 
        } 
        if(rowBooked > Booked)  
        { Booked = rowBooked; 
        maxRow = i; } 
    } 
    printf("Available: %d\nRow with most bookings: %d\n", available, maxRow + 1); 
    return 0; 
} 
