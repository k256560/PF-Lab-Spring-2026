#include <stdio.h> 
float applyDiscount(float price, int tier) { 
    float rate = 0; 
    if (tier == 1) {
    rate = 0.05;    }  
    else if (tier == 2){ 
    rate = 0.10;  }
    else if (tier == 3){
    rate = 0.20;  }
    else if (tier == 4){ 
    rate = 0.30;  }
    return price * (1 - rate); 
} 
void printInvoice(float original, float discounted) { 
    float delivery = (discounted < 2000) ? 150.0 : 0.0; 
    printf("\n--- Itemized Invoice ---\n"); 
    printf("Original: Rs. %.2f\n", original); 
    printf("Discounted: Rs. %.2f\n", discounted); 
    printf("Delivery: Rs. %.2f\n", delivery); 
    printf("Total: Rs. %.2f\n", discounted + delivery); 
} 
int main() { 
    float p; int t; 
    printf("Enter Price and Membership Tier (1-4): "); 
    scanf("%f %d", &p, &t); 
    printInvoice(p, applyDiscount(p, t)); 
    return 0; 
} 
