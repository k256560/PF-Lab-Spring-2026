#include <stdio.h> 
int main() { int arr[6] = {45, 60, 32, 55, 40, 58}; 
 int *p = arr; 
 int highest = 0; 
for (int i = 0; i < 6; i++) { 
   if (*(p + i) > highest) { 
       highest = *(p + i); 
   } 
} 
printf("Original Marks: "); 
for (int i = 0; i < 6; i++) 
 printf("%d ", *(p + i)); 
for (int i = 0; i < 6; i++) { 
   *(p + i) = (int)(((float)*(p + i) / highest) * 100); 
} 
printf("\nScaled Marks:   "); 
for (int i = 0; i < 6; i++) 
 printf("%d ", *(p + i)); 
printf("\n"); 
return 0; 
} 
