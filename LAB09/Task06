#include <stdio.h> 
float totalRevenue(float bills[], int n) { 
    float sum = 0; 
    for(int i=0; i<n; i++) 
 sum += bills[i]; 
    return sum;
} 
int bestTable(float bills[], int n) { 
    int best = 0; 
    for(int i=1; i<n; i++) 
 if(bills[i] > bills[best]) 
 best = i; 
    return best; 
}  
int isProfitable(float total) { 
    return (total > 10000); 
} 
int main() {
    float tables[5]; 
    for(int i=0; i<5; i++) { 
        printf("Bill for Table %d: ", i+1); 
        scanf("%f", &tables[i]); 
    } 
    float total = totalRevenue(tables, 5); 
    printf("\nTotal Revenue: %.2f\n", total); 
    printf("Best Table: Table %d\n", bestTable(tables, 5) + 1); 
    printf("Profitable: %s\n", isProfitable(total) ? "Yes" : "No"); 
    return 0; 
} 
