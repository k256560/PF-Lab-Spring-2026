#include <stdio.h> 
int main() { void *sensor; 
 int vibrations = 847; 
 float temperature = 73.6;  
char status = 'W'; 
sensor = &vibrations; 
printf("Vibrations: %d | Address: %p\n", *(int *)sensor, (void *)sensor); 
sensor = &temperature; 
printf("Temperature: %.1f | Address: %p\n", *(float *)sensor, (void *)sensor); 
sensor = &status; 
printf("Status Code: %c | Address: %p\n", *(char *)sensor, (void *)sensor); 
if (*(char *)sensor == 'N')  
printf("Alert: Normal Operation\n"); 
else if (*(char *)sensor == 'W')  
printf("Alert: Warning! Check sensors.\n"); 
else if (*(char *)sensor == 'C') 
 printf("Alert: Critical Failure!\n"); 
return 0; 
} 
