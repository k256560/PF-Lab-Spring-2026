#include <stdio.h> 
int totalPower(int floors) { 
    if (floors == 1) 
        return 100; 
    int currentFloorPower = 100 * (1 << (floors - 1));  
    return currentFloorPower + totalPower(floors - 1); 
} 
int main() { 
    int floors; 
    printf("Enter number of floors: "); 
    scanf("%d", &floors); 
    printf("Total Power Consumption: %d kWh\n", totalPower(floors)); 
    return 0; 
} 
